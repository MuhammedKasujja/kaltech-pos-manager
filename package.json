{
  "name": "kaltech-pos-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "routes": "next typegen && tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mdx}\"",
    "dev:prisma": "npx prisma generate && npx prisma migrate deploy",
    "dev:prisma:force": "npx prisma migrate reset --force && npx prisma migrate dev --name init",
    "postinstall": "prisma generate && prisma migrate deploy"
  },
